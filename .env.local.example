# ============================================================
# Supabase – Pflichtfelder
# ============================================================
# Supabase Dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# "Publishable" (anon) Key – darf im Browser stehen
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service-Role Key (NUR serverseitig! NIEMALS im Browser)
# Supabase Dashboard: Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# App-Konfiguration
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin-E-Mail (Empfänger der Admin-Benachrichtigungen)
ADMIN_EMAIL=david.privatklavierunterricht@gmail.com

# Google Maps – für den Preisrechner (Distanz/Wegaufschlag)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ============================================================
# E-Mail-Versand (Resend via SMTP)
# ============================================================
# Resend bietet einen SMTP-Endpoint. User ist wörtlich "resend",
# das Passwort ist dein Resend-API-Key (re_...).
# Domain privatklavierunterricht.ch muss in Resend verifiziert sein.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM=david@privatklavierunterricht.ch
SMTP_FROM_NAME=David – Klavierunterricht

# Schutz für den Cron-Endpoint (/api/cron/send-emails)
# Beliebiger langer Zufallsstring – exakt derselbe Wert auf Vercel.
CRON_SECRET=

# ============================================================
# Zahlungen – TWINT
# ============================================================
# Basis-Deeplink deines TWINT/RaiseNow-Pay-Links. Der Code hängt
# &trxInfo=... &amount=... an. Beispiel: https://pay.raisenow.io/xxxxx?...
TWINT_BASE_URL=

# ============================================================
# Zahlungen – Schweizer QR-Rechnung (LivingTech QR-Bill API)
# ============================================================
# API-Key von LivingTech (https://www.livingtech.ch) – serverseitig.
LIVINGTECH_API_KEY=
# Creditor-Defaults sind im Code hinterlegt; nur überschreiben falls nötig.
PIANO_IBAN=CH6808307000541179306
PIANO_CREDITOR_NAME=David Ramchandani
PIANO_CREDITOR_ADDRESS=Sattleracherstrasse 59, 8413 Neftenbach

# ============================================================
# Google Calendar Sync (Service Account, One-Way System → Google)
# ============================================================
# Vollständige Service-Account-JSON als EINZEILER (escaped).
# Google Cloud Console: IAM > Service Accounts > Keys > JSON erzeugen.
# Den Ziel-Kalender für die client_email des Service-Accounts freigeben.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","client_email":"...@...iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Calendar-ID (z. B. die Gmail-Adresse des Kalenders oder eine ...@group.calendar.google.com)
GOOGLE_CALENDAR_ID=primary

# ============================================================
# Push-Benachrichtigungen (Web Push / VAPID)
# ============================================================
# Erzeugen mit:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:david.privatklavierunterricht@gmail.com
