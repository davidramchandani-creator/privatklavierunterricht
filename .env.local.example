# ============================================================
# Supabase – Pflichtfelder
# ============================================================
# Aus deinem Supabase-Projektdashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-Role Key (nur serverseitig! NIEMALS im Browser)
# Supabase Dashboard: Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Google Maps – für den Preisrechner
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ============================================================
# Google Calendar – für Termin-Sync (OAuth2)
# ============================================================
# Aus Google Cloud Console: APIs & Services > Credentials
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_CALENDAR_ID=primary

# Refresh Token nach einmaliger OAuth-Authorisierung
GOOGLE_REFRESH_TOKEN=1//...

# ============================================================
# E-Mail (SMTP) – für Benachrichtigungen
# ============================================================
# Empfohlen: Resend (resend.com) oder SendGrid
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM=david@deine-domain.ch
SMTP_FROM_NAME=David – Klavierunterricht

# ============================================================
# Zahlungen
# ============================================================
# Dein persönlicher Twint-Link (wird im Portal angezeigt)
NEXT_PUBLIC_TWINT_LINK=https://pay.raisenow.io/...

# ============================================================
# App-Konfiguration
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_ADRESSE=Sattleracherstrasse 59, 8413 Neftenbach, Schweiz

# Admin-E-Mail (für Benachrichtigungen an David)
ADMIN_EMAIL=david@deine-domain.ch

# Resend API-Key (resend.com > API Keys)
RESEND_API_KEY=re_...

# Cron-Job Schutz (beliebiger langer zufälliger String, gleicher Wert auf Vercel setzen)
CRON_SECRET=...
